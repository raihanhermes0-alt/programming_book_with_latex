{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build PDF",
      "type": "shell",
      "command": "latexmk",
      "args": [
        "-pdf",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-synctex=1",
        "-outdir=build",
        "main.tex"
      ],
      "problemMatcher": []
    },
    {
      "label": "Build DOCX",
      "type": "shell",
      "command": "sh",
      "args": [
        "-c",
        "mkdir -p build && pandoc --from=latex --to=docx main.tex --output=build/main.docx"
      ],
      "problemMatcher": []
    },
    {
      "label": "Build PDF and DOCX",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Build PDF",
        "Build DOCX"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
